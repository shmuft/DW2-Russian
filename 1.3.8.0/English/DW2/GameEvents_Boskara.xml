<?xml version="1.0"?>
<ArrayOfGameEvent xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<GameEvent>
		<Name>Underlords (Boskara)</Name>
		<Conditions>
			<GameEventCondition>
				<Type>CheckOrbResourceCount</Type>
				<ComparisonType>LessThan</ComparisonType>
				<ComparisonValue>5</ComparisonValue> <!-- Total Resources Amount -->
			</GameEventCondition>
		</Conditions>
		<TriggerActions>
			<GameEventAction>
				<Type>GenerateResourceAtOrb</Type>
				<MessageTitle>Underlords</MessageTitle>
				<Description>We have recently colonized [LOCATION]{0}[/LOCATION], a Volcanic world native for the Boskara.\n\nIn the initial burst of exploration at the new colony, our settlers have found a new resource!\n\nWe have uncovered a new source of [RESOURCE]RESOURCENAME[/RESOURCE] at {0}.</Description>
				<ImageFilepath>Environment/Events/Boskara Underlords</ImageFilepath>
				<Id1>-1</Id1> <!-- Resource Id (-1=Random) -->
				<Value1>0</Value1> <!-- Abundance (>0 to 1, 0=Default for Resource) -->
				<Value2>2</Value2> <!-- Discovery Level -->
				<Value3>5</Value3> <!-- Max Total Resource Limit (0=Unlimited) -->
				<MessageViewMode>Dialog</MessageViewMode>
				<DelaySecondsMinimum>5</DelaySecondsMinimum>
				<DelaySecondsMaximum>5</DelaySecondsMaximum>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
	<GameEvent>
		<Name>We Reign Supreme (Boskara)</Name>
		<TriggerActions>
			<GameEventAction>
				<Type>StartColonyEvent</Type>
				<MessageTitle>We Reign Supreme</MessageTitle>
				<Description>Our recent conquest of another empire's homeworld has filled our population with euphoric pride!\n\nThus for the next 10 years our empire will enjoy the following benefits:[ULI]+20% Empire Happiness[/ULI][ULI]+50% War Weariness Reduction[/ULI]</Description>
				<ImageFilepath>Environment/Events/Boskara We Reign Supreme</ImageFilepath>
				<ActionLocationHint>HomeColony</ActionLocationHint>
				<Id1>132</Id1> <!-- Colony Event Id, Current Value = We Reign Supreme -->
				<Id2>-1</Id2> <!-- 0=Send Message -->
				<Id3>-1</Id3> <!-- If no valid ActionLocation then -1=Empire Capital, 0=Highest Developed Colony, 1=Random Colony -->
				<Value1>1</Value1> <!-- 1=Restart With New Duration Period -->
				<MessageViewMode>Dialog</MessageViewMode>
				<DelaySecondsMinimum>5</DelaySecondsMinimum>
				<DelaySecondsMaximum>5</DelaySecondsMaximum>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
	<GameEvent>
		<Name>Crazed Cannibalism (Boskara)</Name>
		<TriggerActions>
			<GameEventAction>
				<Type>StartColonyEvent</Type>
				<MessageTitle>Crazed Cannibalism</MessageTitle>
				<Description>A life without war and conquest does not suit the belligerent Boskara.\n\nTimes of peace have driven the populace at our colony [LOCATION]{0}[/LOCATION] into an insane frenzy. Due to this hyper-aggressive paranoia, there has been widespread cannibalism!\n\nWe expect this frenzy to last for six months. During that time there will be significant population losses at {0}.</Description>
				<ImageFilepath>Environment/Events/Crazed Cannibalism</ImageFilepath>
				<Id1>19</Id1> <!-- Colony Event Id, Current Value = Crazed Cannibalism -->
				<Id2>-1</Id2> <!-- 0=Send Message -->
				<Id3>-1</Id3> <!-- If no valid ActionLocation then -1=Empire Capital, 0=Highest Developed Colony, 1=Random Colony -->
				<Value1>1</Value1> <!-- 1=Restart With New Duration Period -->
				<MessageViewMode>Dialog</MessageViewMode>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
	<GameEvent>
		<Name>Warspawn (Boskara)</Name>
		<Conditions>
			<GameEventCondition>
				<Type>EmpireNotHaveAnyCharacterAvailableWithTrait</Type>
				<VariableName>Warspawn</VariableName>
			</GameEventCondition>
		</Conditions>
		<SuppressTriggerDescriptions>true</SuppressTriggerDescriptions>
		<TriggerActions>
			<GameEventAction>
				<Type>TriggerEvent</Type>
				<ActionLocationHint>GeneratedItemFromFirstAction</ActionLocationHint>
				<GeneratedItemName>Warspawn Choice (Boskara)</GeneratedItemName>
				<DelaySecondsMinimum>5</DelaySecondsMinimum>
				<DelaySecondsMaximum>5</DelaySecondsMaximum>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
	<GameEvent>
		<Name>Warspawn Choice (Boskara)</Name>
		<TriggerActionsAreChoices>true</TriggerActionsAreChoices>
		<SuppressTriggerDescriptions>true</SuppressTriggerDescriptions>
		<TriggerActions>
			<GameEventAction>
				<Type>TriggerEvent</Type>
				<MessageTitle>Warspawn</MessageTitle>
				<Description>Our recent war declaration provides us the opportunity to assign a [HL]Warspawn[/HL] to lead our war.\n\nIf we choose to do this, a [CHARACTER]new Admiral or General[/CHARACTER] will appear with the Warspawn trait, giving them [BONUS]great strength in ground and space combat[/BONUS].\n\nAdditionally, having a Warspawn in our empire allows us to implement [HL]War Spawning[/HL], where we can periodically convert 10% of a colony's population into 10 Infantry troop units.\n\nHowever it will also [WARN]very negatively impact our relations[/WARN] with all other empires with whom we do not already have a Non-Aggression Pact or a Defense treaty.\n\nShould we assign a Warspawn?</Description>
				<ImageFilepath>Environment/Events/Boskara Warspawn</ImageFilepath>
				<ActionLocationHint>GeneratedItemFromFirstAction</ActionLocationHint>
				<ChoiceButtonText>Assign a Warspawn!</ChoiceButtonText>
				<GeneratedItemName>Implement Warspawn (Boskara)</GeneratedItemName>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
			<GameEventAction>
				<Type>TriggerEvent</Type>
				<ActionLocationHint>GeneratedItemFromFirstAction</ActionLocationHint>
				<ChoiceButtonText>Do Not Use a Warspawn</ChoiceButtonText>
				<ActionObjectId>-1</ActionObjectId>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
	<GameEvent>
		<Name>Implement Warspawn (Boskara)</Name>
		<SuppressTriggerDescriptions>true</SuppressTriggerDescriptions>
		<TriggerActions>
			<GameEventAction>
				<Type>CustomCode</Type>
				<GeneratedItemName>GenerateWarspawn</GeneratedItemName>
				<AllConditionsMustBeMet>false</AllConditionsMustBeMet>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
	<GameEvent>
		<Name>War Spawning (Boskara)</Name>
		<SuppressTriggerDescriptions>true</SuppressTriggerDescriptions>
		<TriggerActions>
			<GameEventAction>
				<Type>ReducePopulationAtColony</Type>
				<Value1>0.9</Value1> <!-- Ratio Amount (>0 to 1) -->
				<AllConditionsMustBeMet>false</AllConditionsMustBeMet>
			</GameEventAction>
			<GameEventAction>
				<Type>GenerateTroops</Type>
				<Id1>22</Id1> <!-- Troop Id, Current Value = Executioner Hive -->
				<Value1>10</Value1> <!-- Troop Amount -->
				<AllConditionsMustBeMet>false</AllConditionsMustBeMet>
			</GameEventAction>
		</TriggerActions>
	</GameEvent>
</ArrayOfGameEvent>