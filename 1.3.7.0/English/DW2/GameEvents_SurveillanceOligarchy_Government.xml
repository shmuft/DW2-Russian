<?xml version="1.0"?>
<ArrayOfGameEvent xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<GameEvent>
		<Name>Initialise Government (Surveillance Oligarchy)</Name>
		<TechLevelThreshold>1</TechLevelThreshold>
		<TriggerActions>
			<GameEventAction>
				<Type>GeneralStoryMessageToEmpire</Type>
				<MessageTitle>Surveillance Oligarchy</MessageTitle>
